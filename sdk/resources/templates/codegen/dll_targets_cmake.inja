{% for mod in dll_modules %}
# DLL module: {{ mod.target_name }}
if(EXISTS "{{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}/{{ mod.output_dir }}/sources.cmake")
    set(_REXGLUE_RESTORE_GENERATED_SOURCES FALSE)
    if(DEFINED GENERATED_SOURCES)
        set(_REXGLUE_PREVIOUS_GENERATED_SOURCES {{ cmake_var("GENERATED_SOURCES") }})
        set(_REXGLUE_RESTORE_GENERATED_SOURCES TRUE)
    endif()
    include({{ mod.output_dir }}/sources.cmake)
    set(DLL_SOURCES_{{ mod.target_name }} {{ cmake_var("GENERATED_SOURCES") }})
    if(_REXGLUE_RESTORE_GENERATED_SOURCES)
        set(GENERATED_SOURCES {{ cmake_var("_REXGLUE_PREVIOUS_GENERATED_SOURCES") }})
    else()
        unset(GENERATED_SOURCES)
    endif()
    unset(_REXGLUE_PREVIOUS_GENERATED_SOURCES)
    unset(_REXGLUE_RESTORE_GENERATED_SOURCES)
    if(REXGLUE_PLATFORM_SWITCH)
        # Nintendo Switch cannot load a shared library: the module's objects go into
        # the host executable. Its exports and image globals get names of their own,
        # and it registers itself under the library's file name (register.cpp), where
        # KernelState's DynamicLibrary::Load finds it.
        add_library({{ mod.lib_name }} OBJECT {{ cmake_var("DLL_SOURCES_" + mod.target_name) }})
        target_compile_definitions({{ mod.lib_name }} PRIVATE
            REX_STATIC_MODULE_FILE="{{ mod.lib_name }}"
            ReXModule_Register=ReXModule_Register_{{ mod.target_name }}
            ReXModule_GetImageInfo=ReXModule_GetImageInfo_{{ mod.target_name }}
            PPCImageConfig=PPCImageConfig_{{ mod.target_name }}
            PPCFuncMappings=PPCFuncMappings_{{ mod.target_name }}
        )
    else()
        add_library({{ mod.lib_name }} SHARED {{ cmake_var("DLL_SOURCES_" + mod.target_name) }})
    endif()
    list(APPEND REXGLUE_DLL_MODULE_TARGETS {{ mod.lib_name }})
    target_include_directories({{ mod.lib_name }} PRIVATE
        {{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}
        {{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}/{{ mod.output_dir }}
    )
    target_link_libraries({{ mod.lib_name }} PRIVATE rex::runtime)
    rexglue_apply_recomp_settings({{ mod.lib_name }}
        "{{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}/{{ mod.output_dir }}/{{ project }}_pch.h")
    # A cross build (Android, Switch) has no rexglue to run, so no codegen target.
    if(TARGET {{ project }}_codegen)
        add_dependencies({{ mod.lib_name }} {{ project }}_codegen)
    endif()
    if(REXGLUE_PLATFORM_SWITCH)
        rexglue_apply_target_settings({{ mod.lib_name }})
        # The host target is declared after this file is included.
        cmake_language(EVAL CODE
            "cmake_language(DEFER CALL target_link_libraries {{ cmake_var("REXGLUE_HOST_TARGET") }} PRIVATE {{ mod.lib_name }})")
    else()
        set_target_properties({{ mod.lib_name }} PROPERTIES
            CXX_VISIBILITY_PRESET hidden
        )
        rexglue_configure_module_target({{ mod.lib_name }} HOST {{ cmake_var("REXGLUE_HOST_TARGET") }})
    endif()
endif()
{% endfor %}
